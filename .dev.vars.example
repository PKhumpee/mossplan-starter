# The deploy form asks for these two values. Never commit real values.
# SETUP_TOKEN is any long random string, entered once at /admin/setup.
# MOSS_SECRET_KEY is the base64 of 32 random bytes. Do not change it after setup.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETUP_TOKEN=
MOSS_SECRET_KEY=
