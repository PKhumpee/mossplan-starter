{
  "$schema": "mossplan-design-tokens/v1",
  "name": "Mossplan",
  "defaultTheme": "light",
  "color": {
    "light": {
      "bg": "#F6F8F7",
      "surface": "#FFFFFF",
      "grid": "#DDE5E0",
      "primary": "#3F6B3A",
      "secondary": "#1E3A5F",
      "text": "#14201A",
      "muted": "#5B6B62"
    },
    "dark": {
      "bg": "#0E1726",
      "surface": "#152033",
      "grid": "#1E3A5F",
      "primary": "#7FB069",
      "secondary": "#8FB3D9",
      "text": "#E8EEF2",
      "muted": "#9AA8B5"
    }
  },
  "font": {
    "sans": "Inter, 'IBM Plex Sans Thai', 'Noto Sans Thai', system-ui, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, monospace"
  },
  "space": { "0": "0px", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px" },
  "radius": { "base": "6px" },
  "cli": { "accent": "#7FB069", "ansiFallback": "green" }
}
