{
  "name": "mossplan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "moss": "node packages/cli/src/index.js",
    "dev": "astro dev",
    "build:og": "tsx scripts/build-og.ts",
    "build": "pnpm fetch-media && pnpm build:og && astro build && pnpm redirects && pnpm well-known && pnpm pagefind && pnpm check:seo && pnpm check:assets && pnpm check:affiliate && pnpm check:media",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "snapshot": "tsx scripts/snapshot.ts",
    "fetch-media": "tsx scripts/fetch-media.ts",
    "check:assets": "tsx scripts/check-asset-count.ts",
    "check:media": "tsx scripts/check-dist-media.ts",
    "redirects": "tsx scripts/redirects.ts",
    "well-known": "tsx scripts/well-known.ts",
    "pagefind": "tsx scripts/pagefind.ts",
    "check:seo": "tsx scripts/seo-audit.ts",
    "check:affiliate": "tsx scripts/check-affiliate.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "tsx scripts/db-migrate-local.ts",
    "db:seed:local": "tsx scripts/db-seed.ts",
    "admin:invite": "tsx scripts/admin-invite.ts",
    "backup": "tsx scripts/backup.ts backup",
    "backup:list": "tsx scripts/backup.ts list",
    "backup:restore": "tsx scripts/backup.ts restore",
    "e2e": "playwright test",
    "check:csp-nonce": "tsx scripts/check-csp-nonce.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.0.3",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-bubble-menu": "^3.32.0",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-youtube": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "astro": "^7.3.8",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "satori": "0.56.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.1",
    "jsonc-parser": "^3.3.1",
    "oxlint": "^1.87.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
