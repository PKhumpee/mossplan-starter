---
// Cloudflare Web Analytics cookieless beacon (CONTRACTS §1a, §2, S5, D11).
// Renders the script only when PUBLIC_CF_BEACON_TOKEN is set.
const token =
  import.meta.env.PUBLIC_CF_BEACON_TOKEN ||
  (typeof process !== 'undefined' ? process.env.PUBLIC_CF_BEACON_TOKEN : undefined);
---

{token ? (
  <script
    type="module"
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token })}
  />
) : null}
