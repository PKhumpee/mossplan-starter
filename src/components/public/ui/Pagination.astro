---
// Pagination (DESIGN §4.5): Stripe pill style. Previous/next buttons plus up to 5 page numbers.
// Touch targets ≥ 38px, tabular numbers, hairline borders.
// Callers must never produce a `/page/1/` URL (CONTRACTS §7).
interface Props {
  page: number;
  totalPages: number;
  hrefFor: (page: number) => string;
}

const { page, totalPages, hrefFor } = Astro.props;

// Up to 5 numbers centred on the current page, clamped to the range.
const windowStart = Math.max(1, Math.min(page - 2, totalPages - 4));
const windowEnd = Math.min(totalPages, windowStart + 4);
const pages: number[] = [];
for (let p = windowStart; p <= windowEnd; p++) pages.push(p);
---

<nav aria-label="สำรวจหน้า" class="flex flex-wrap items-center justify-center gap-2">
  {page > 1 ? (
    <a
      href={hrefFor(page - 1)}
      class="inline-flex min-h-[38px] items-center rounded-full border border-border bg-bg px-4 py-1.5 text-body-sm text-text-secondary transition-colors hover:border-brand hover:text-brand"
    >
      « ก่อนหน้า
    </a>
  ) : (
    <span
      aria-disabled="true"
      class="inline-flex min-h-[38px] items-center rounded-full border border-border/60 bg-surface px-4 py-1.5 text-body-sm text-muted opacity-50 cursor-not-allowed"
    >
      « ก่อนหน้า
    </span>
  )}

  <div class="flex items-center gap-1 tabular-nums">
    {pages.map((p) =>
      p === page ? (
        <span
          aria-current="page"
          class="inline-flex size-9 items-center justify-center rounded-full border border-brand bg-brand text-body-sm font-semibold text-brand-contrast shadow-sm"
        >
          {p}
        </span>
      ) : (
        <a
          href={hrefFor(p)}
          class="inline-flex size-9 items-center justify-center rounded-full border border-border bg-bg text-body-sm text-text-secondary transition-colors hover:border-brand hover:text-brand"
        >
          {p}
        </a>
      ),
    )}
  </div>

  {page < totalPages ? (
    <a
      href={hrefFor(page + 1)}
      class="inline-flex min-h-[38px] items-center rounded-full border border-border bg-bg px-4 py-1.5 text-body-sm text-text-secondary transition-colors hover:border-brand hover:text-brand"
    >
      ถัดไป »
    </a>
  ) : (
    <span
      aria-disabled="true"
      class="inline-flex min-h-[38px] items-center rounded-full border border-border/60 bg-surface px-4 py-1.5 text-body-sm text-muted opacity-50 cursor-not-allowed"
    >
      ถัดไป »
    </span>
  )}
</nav>
