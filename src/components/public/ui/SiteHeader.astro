---
// Site header (DESIGN §4.5): Stripe hairline navbar aesthetic.
// Deep navy text logo, hairline bottom border, and clean horizontal navigation.
// No JS: the category row scrolls horizontally on small screens.
interface Props {
  siteName: string;
  categories?: { slug: string; name: string }[];
}

const { siteName, categories = [] } = Astro.props;
const runtimeSiteName = siteName ? '__MOSS_SITE_NAME__' : 'Mossplan';
const shown = categories.slice(0, 6);
---

<header class="border-b border-border bg-bg/95 backdrop-blur-sm">
  <div class="mx-auto max-w-listing px-4 md:px-6">
    <div class="flex items-center justify-between gap-4 py-3.5">
      <a
        href="/"
        class="text-[1.3rem] font-bold tracking-normal text-text transition-colors hover:text-brand"
      >
        {runtimeSiteName}
      </a>
      <a
        href="/search/"
        class="flex size-10 items-center justify-center rounded-full text-muted transition-colors hover:bg-surface hover:text-brand"
        aria-label="ค้นหาบทความ"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </a>
    </div>
    {shown.length > 0 && (
      <nav aria-label="หมวดหมู่" class="pb-2.5">
        <ul class="flex items-center gap-5 overflow-x-auto text-body-sm font-medium">
          {shown.map((category) => (
            <li class="shrink-0">
              <a
                href={`/category/${category.slug}/`}
                class="whitespace-nowrap text-muted transition-colors hover:text-brand"
              >
                {category.name}
              </a>
            </li>
          ))}
          <li class="shrink-0">
            <a
              href="/archive/"
              class="whitespace-nowrap text-muted transition-colors hover:text-brand"
            >
              หมวดหมู่ทั้งหมด
            </a>
          </li>
        </ul>
      </nav>
    )}
  </div>
</header>
