---
// YouTube facade (DESIGN §4.5): Stripe card aesthetic. A 16:9 poster box with a play button and title.
// The iframe only loads after a click — this is the only article JS (CONTRACTS §9, ≤ 2 KB). On the
// styleguide (and anywhere else with `interactive` off) it renders as a static box with no script.
interface Props {
  videoId: string;
  title: string;
  /** Include the click-to-load script. Off keeps the page at zero JS. */
  interactive?: boolean;
}

const { videoId, title, interactive = false } = Astro.props;
const poster = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
---

<div class="youtube-facade" data-video-id={videoId}>
  <button
    type="button"
    class="group relative block aspect-video w-full overflow-hidden rounded-xl border border-border bg-surface shadow-card transition-all hover:shadow-elevated"
    aria-label={`เปิดวิดีโอ ${title} บน YouTube`}
  >
    <img
      src={poster}
      alt=""
      width="480"
      height="360"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-102"
    />
    <span class="absolute inset-0 flex items-center justify-center bg-black/25 transition-colors group-hover:bg-black/35">
      <span class="flex size-14 items-center justify-center rounded-full bg-brand text-brand-contrast shadow-elevated transition-transform duration-200 group-hover:scale-108">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M8 5.14v13.72L19 12z"></path>
        </svg>
      </span>
    </span>
    <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-4 text-left text-body-sm font-semibold text-white">
      {title}
    </span>
  </button>
</div>

{interactive && <script is:inline>
  // Click-to-load: replace the facade with a youtube-nocookie iframe. Delegated and guarded so
  // multiple facades (or repeated render) bind exactly once. Keep under 2 KB (§12).
  (function () {
    if (window.__ytFacadeBound) return;
    window.__ytFacadeBound = true;
    document.addEventListener('click', function (event) {
      var button = event.target.closest('.youtube-facade > button');
      if (!button) return;
      var box = button.parentElement;
      var id = box.dataset.videoId;
      var iframe = document.createElement('iframe');
      iframe.width = '560';
      iframe.height = '315';
      iframe.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
      iframe.title = button.getAttribute('aria-label') || 'วิดีโอ YouTube';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.style.aspectRatio = '16 / 9';
      iframe.style.width = '100%';
      iframe.style.height = 'auto';
      iframe.style.border = '0';
      box.replaceChildren(iframe);
    });
  })();
</script>}
