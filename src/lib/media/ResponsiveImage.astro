---
// Responsive image component (CONTRACTS §1a, DESIGN §11.5, T13).
// Renders <picture> with AVIF + WebP sources at the S3 recommended widths,
// explicit width and height, decoding="async", loading="lazy" except priority (cover: eager + fetchpriority="high").
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';

interface Props {
  mediaId: string;
  alt?: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
  isAvatar?: boolean;
}

const originals = import.meta.glob<ImageMetadata>(
  '/src/generated/media/**/*.{jpg,jpeg,png,webp,avif,gif}',
  { import: 'default' },
);

const {
  mediaId,
  alt,
  sizes = '(min-width: 768px) 720px, 100vw',
  priority = false,
  class: className,
  isAvatar = false,
} = Astro.props;

const item = await getEntry('media', mediaId);
if (!item) {
  throw new Error(`media ${mediaId} is not in the snapshot`);
}

// Find key in originals: support full key, basename, or id
const keyCandidates = [
  `/src/generated/media/${item.data.key}`,
  `/src/generated/media/${item.data.key.replace(/^fixtures\//, '')}`,
  `/src/generated/media/${mediaId}.webp`,
  `/src/generated/media/${mediaId}.jpg`,
  `/src/generated/media/${mediaId}.png`,
  `/src/generated/media/${mediaId}.avif`,
  `/src/generated/media/${mediaId}.gif`,
];

let load: (() => Promise<ImageMetadata>) | undefined;
for (const cand of keyCandidates) {
  if (originals[cand]) {
    load = originals[cand];
    break;
  }
}

if (!load) {
  const base = item.data.key.split('/').pop();
  for (const [path, loader] of Object.entries(originals)) {
    if (path.endsWith(`/${base}`) || path.includes(`/${mediaId}.`)) {
      load = loader;
      break;
    }
  }
}

if (!load) {
  throw new Error(`media file ${item.data.key} was not fetched into src/generated/media/`);
}

const src = await load();

const isAuthorAvatar = isAvatar || item.data.key.includes('avatar') || mediaId.includes('avatar');

const WIDTHS = isAuthorAvatar ? [96, 192] : [480, 800, 1200];
const widths = WIDTHS.filter((w) => w <= src.width);
if (widths.length === 0) widths.push(src.width);
const width = widths.at(-1) ?? src.width;
const height = isAuthorAvatar ? width : Math.round((src.height / src.width) * width);
const resolvedSizes = isAuthorAvatar ? `${width}px` : sizes;
---

<Picture
  src={src}
  alt={alt ?? item.data.alt ?? ''}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  widths={widths}
  width={width}
  height={height}
  sizes={resolvedSizes}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  class={className}
/>
