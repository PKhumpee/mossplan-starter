---
// 404 Not Found page (DESIGN §5.5, CONTRACTS §7):
// Served with status 404 via wrangler.jsonc assets option, noindex, no canonical link,
// search box form (plain GET to /search/, zero JS), and latest 6 articles.
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/public/ui/ArticleCard.astro';
import {
  getAllCategories,
  getCategoryById,
  getMediaById,
  getPublishedArticles,
  getSiteInfo,
} from '../lib/content/queries';
import { readingTimeMinutes } from '../lib/format/thai';
import { extractNodeText } from '../lib/content/render';
import type { TiptapNode } from '../shared/snapshot';

const site = getSiteInfo();
const categories = getAllCategories();
const latestArticles = getPublishedArticles().slice(0, 6);

const title = `ไม่พบหน้าที่คุณต้องการ — ${site.name}`;
const description = `หน้าที่คุณกำลังค้นหาอาจถูกย้าย ลบ หรือไม่มีอยู่แล้ว ค้นหาบทความอื่น ๆ หรือกลับไปยังหน้าแรก`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={null}
  noindex={true}
  siteName={site.name}
  siteDescription={site.description}
  categories={categories}
>
  <div class="mx-auto max-w-listing px-4 py-12 md:px-6 md:py-16">
    <div class="mx-auto max-w-prose text-center">
      <p class="text-caption font-bold text-brand uppercase tracking-wider">ข้อผิดพลาด 404</p>
      <h1 class="mt-3 text-h1 md:text-[2.75rem] font-bold text-text">ไม่พบหน้าที่คุณต้องการ</h1>
      <p class="mt-4 text-body text-text-secondary">
        หน้าที่คุณกำลังค้นหาอาจถูกย้าย ลบ หรือไม่มีอยู่แล้วในระบบ คุณสามารถลองค้นหาบทความใหม่
        หรือเลือกอ่านบทความน่าสนใจด้านล่าง
      </p>

      <!-- Search Form (Plain HTML GET, Zero JS per DESIGN §5.5) -->
      <form action="/search/" method="get" class="mt-8 flex gap-2 justify-center max-w-md mx-auto">
        <input
          type="search"
          name="q"
          placeholder="ค้นหาบทความ..."
          required
          aria-label="ค้นหาบทความ"
          class="flex-1 rounded-full border border-border-input bg-bg px-4 py-2.5 text-body-sm text-text placeholder:text-muted focus-visible:outline-none focus-visible:border-brand shadow-sm"
        />
        <button
          type="submit"
          class="rounded-full bg-brand px-6 py-2.5 text-body-sm font-semibold text-brand-contrast shadow-sm transition-all hover:bg-brand-deep hover:shadow-card focus-visible:outline-none"
        >
          ค้นหา
        </button>
      </form>
    </div>

    <!-- Latest 6 Articles -->
    <section aria-labelledby="latest-fallback" class="mt-16 border-t border-border pt-12">
      <div class="mb-8 flex items-baseline justify-between border-b border-border pb-3">
        <h2 id="latest-fallback" class="text-h2 md:text-[1.75rem] font-bold text-text">
          บทความน่าสนใจล่าสุด
        </h2>
        <a href="/" class="text-caption font-semibold text-brand hover:text-brand-deep">
          กลับสู่หน้าแรก →
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {latestArticles.map((article) => {
          const media = article.coverMediaId ? getMediaById(article.coverMediaId) : undefined;
          const category = getCategoryById(article.categoryId);
          const readingTime = readingTimeMinutes(
            `${article.excerpt} ${extractNodeText(article.content as TiptapNode)}`,
          );

          return (
            <ArticleCard
              href={`/${article.slug}/`}
              title={article.title}
              excerpt={article.excerpt}
              categoryLabel={category?.name}
              dateMs={article.publishedAt}
              readingMinutes={readingTime}
              image={
                media
                  ? {
                      mediaId: media.id,
                      src: `/media/${media.id}.webp`,
                      width: media.width ?? 640,
                      height: media.height ?? 360,
                      alt: media.alt || article.title,
                    }
                  : undefined
              }
            />
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>
