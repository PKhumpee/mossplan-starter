---
// Article detail page (DESIGN §5.2, CONTRACTS §7): answer-first lead,
// author byline, optional reviewer, TOC (when ≥ 3 H2), prose body (data-pagefind-body),
// author profile box, related articles, prev/next links.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/public/ui/Breadcrumbs.astro';
import TagChip from '../../components/public/ui/TagChip.astro';
import ArticleCard from '../../components/public/ui/ArticleCard.astro';
import ResponsiveImage from '../../lib/media/ResponsiveImage.astro';
import {
  getAllCategories,
  getPublishedArticles,
  getCategoryById,
  getAuthorById,
  getMediaById,
  getTagById,
  getRelatedArticles,
  getAdjacentArticles,
  getSiteInfo,
  getSnapshot,
} from '../../lib/content/queries';
import { renderContent } from '../../lib/content/render';
import { formatThaiDate } from '../../lib/format/date';
import { readingTimeMinutes } from '../../lib/format/thai';
import { extractNodeText } from '../../lib/content/render';
import type { TiptapNode } from '../../shared/snapshot';
import JsonLd from '../../components/seo/JsonLd.astro';
import Disclosure from '../../components/public/affiliate/Disclosure.astro';
import { buildArticleGraph } from '../../lib/seo/schema';
import { buildSite } from '../../shared/site';
import { articleAlternates, articleDescription, articleTitle } from '../../lib/seo/metadata';

export async function getStaticPaths() {
  const articles = getPublishedArticles().filter(
    (article) => article.lang !== getSnapshot().site.defaultLang,
  );
  return articles.map((article) => ({
    params: { lang: article.lang, slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const site = getSiteInfo();
const categories = getAllCategories();

const category = getCategoryById(article.categoryId);
const author = getAuthorById(article.authorId);
const reviewer = article.reviewerId ? getAuthorById(article.reviewerId) : undefined;
const coverMedia = article.coverMediaId ? getMediaById(article.coverMediaId) : undefined;
const authorAvatar = author?.avatarMediaId ? getMediaById(author.avatarMediaId) : undefined;

// Render Tiptap document to safe HTML and extract headings
const snapshot = getSnapshot();
const rendered = renderContent(article.content, {
  affiliateLinks: snapshot.affiliateLinks,
  articleTitle: article.title,
  articleSlug: article.slug,
});
const h2Headings = rendered.headings.filter((h) => h.level === 2);

// Dates & reading time (DESIGN §5.2)
// Show "อัปเดตล่าสุด" only when updatedAt is > 1 day after publishedAt (D30)
const isUpdated = article.updatedAt - article.publishedAt > 86400000;
const readingTime = readingTimeMinutes(
  `${article.excerpt} ${extractNodeText(article.content as TiptapNode)}`,
);

// Tags, related, and adjacent articles
const tags = article.tagIds
  .map((tid) => getTagById(tid))
  .filter((t): t is NonNullable<typeof t> => !!t);
const relatedArticles = getRelatedArticles(article, 3);
const { prev, next } = getAdjacentArticles(article);

const canonical = `/${article.lang}/${article.slug}/`;
const title = articleTitle(article.seo.title, article.title, site.name);
const description = articleDescription(article.seo.description, article.excerpt);

const currentSite = buildSite();
const alternateLinks = articleAlternates(
  snapshot.articles,
  article,
  snapshot.site.defaultLang,
  currentSite.url,
);
const siteMeta = {
  url: currentSite.url,
  name: site.name,
  description: site.description,
};

const ogImage = {
  url: `/og/${article.slug}.png`,
  width: 1200,
  height: 630,
  alt: article.title,
};

const canonicalUrl = `${currentSite.url}${canonical}`;
const breadcrumbs = [
  { name: 'หน้าหลัก', url: '/' },
  ...(category ? [{ name: category.name, url: `/category/${category.slug}/` }] : []),
  { name: article.title },
];

const jsonLdGraph = author
  ? buildArticleGraph({
      site: siteMeta,
      canonicalUrl,
      title: article.title,
      description: article.seo.description || article.excerpt,
      slug: article.slug,
      publishedAt: article.publishedAt,
      modifiedAt: article.updatedAt,
      categoryName: category?.name,
      tagNames: tags.map((t) => t.name),
      author: {
        id: author.id,
        name: author.name,
        slug: author.slug,
        jobTitle: author.jobTitle,
        bio: author.bio,
        sameAs: author.sameAs,
        knowsAbout: author.knowsAbout,
      },
      reviewer: reviewer
        ? {
            id: reviewer.id,
            name: reviewer.name,
            slug: reviewer.slug,
            jobTitle: reviewer.jobTitle,
            bio: reviewer.bio,
            sameAs: reviewer.sameAs,
            knowsAbout: reviewer.knowsAbout,
          }
        : null,
      reviewedAt: article.reviewedAt,
      breadcrumbs,
    })
  : [];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  ogImage={ogImage}
  siteName={site.name}
  siteDescription={site.description}
  categories={categories}
  alternateLinks={alternateLinks}
  htmlLang={article.lang}
>
  <JsonLd slot="jsonld" graph={jsonLdGraph} />
  <article class="mx-auto max-w-prose px-4 py-8 md:px-6 md:py-12" data-pagefind-body>
    <!-- Breadcrumbs -->
    <div class="mb-4">
      <Breadcrumbs
        items={[
          ...(category ? [{ label: category.name, href: `/category/${category.slug}/` }] : []),
          { label: article.title },
        ]}
        hideCurrent
      />
    </div>

    <!-- Category Pill -->
    {category && (
      <a
        href={`/category/${category.slug}/`}
        class="mb-3 inline-flex items-center rounded-full bg-brand-subdued/30 px-3 py-0.5 text-caption font-semibold text-brand-deep hover:bg-brand-subdued/45 transition-colors"
        data-pagefind-filter="category"
      >
        {category.name}
      </a>
    )}

    <!-- Main Title (Single H1) -->
    <h1
      class="text-[2rem] leading-[1.3] font-bold text-text md:text-[2.5rem]"
      data-pagefind-meta="title"
    >
      {article.title}
    </h1>

    <!-- Excerpt / Answer-first lead (DESIGN §6.3) -->
    {article.excerpt && (
      <p class="mt-4 text-[1.1875rem] leading-[1.7] text-text-secondary">{article.excerpt}</p>
    )}

    {(article.hasAffiliate || rendered.html.includes('/go/')) && <Disclosure />}

    <!-- Byline & Meta Row -->
    <div class="mt-6 flex flex-wrap items-center gap-3 border-y border-border py-3.5 text-caption text-muted">
      {author && (
        <div class="flex items-center gap-2">
          {authorAvatar && (
            <ResponsiveImage
              mediaId={authorAvatar.id}
              alt={author.name}
              isAvatar
              class="size-8 rounded-full object-cover border border-border"
            />
          )}
          <span>
            เขียนโดย{' '}
            <a href={`/authors/${author.slug}/`} class="font-medium text-text hover:text-brand">
              {author.name}
            </a>
          </span>
        </div>
      )}
      {reviewer && (
        <>
          <span class="opacity-50">·</span>
          <span>
            ตรวจทานโดย{' '}
            <a href={`/authors/${reviewer.slug}/`} class="font-medium text-text hover:text-brand">
              {reviewer.name}
            </a>
          </span>
        </>
      )}
      <span class="opacity-50">·</span>
      <time datetime={new Date(article.publishedAt).toISOString()} class="tabular-nums">
        เผยแพร่ {formatThaiDate(article.publishedAt)}
      </time>
      {isUpdated && (
        <>
          <span class="opacity-50">·</span>
          <time datetime={new Date(article.updatedAt).toISOString()} class="tabular-nums">
            อัปเดตล่าสุด {formatThaiDate(article.updatedAt)}
          </time>
        </>
      )}
      <span class="opacity-50">·</span>
      <span class="tabular-nums">อ่าน {readingTime} นาที</span>
    </div>

    <!-- Cover Image (Priority) -->
    <div class="my-8 aspect-video overflow-hidden rounded-xl border border-border shadow-card bg-surface">
      {coverMedia ? (
        <ResponsiveImage
          mediaId={coverMedia.id}
          alt={coverMedia.alt || article.title}
          priority
          class="h-full w-full object-cover"
        />
      ) : (
        <img
          src={`/og/${article.slug}.png`}
          alt={article.title}
          width="1200"
          height="630"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      )}
    </div>

    <!-- Table of Contents (only when ≥ 3 H2 headings per DESIGN §5.2) -->
    {h2Headings.length >= 3 && (
      <nav
        aria-label="สารบัญ"
        class="my-8 rounded-xl border border-border bg-surface p-5 shadow-sm"
      >
        <p class="text-body-sm font-bold text-text mb-3">สารบัญเนื้อหา</p>
        <ol class="space-y-1.5 text-body-sm list-decimal list-inside text-text-secondary">
          {h2Headings.map((h) => (
            <li>
              <a href={`#${h.id}`} class="text-brand hover:underline underline-offset-2">
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <!-- Prose Content Body -->
    <div class="prose mt-8" set:html={rendered.html} />

    <!-- Tag Chips -->
    {tags.length > 0 && (
      <div class="mt-10 flex flex-wrap gap-2 pt-6 border-t border-border">
        {tags.map((tag) => (
          <TagChip tag={{ slug: tag.slug, name: tag.name }} />
        ))}
      </div>
    )}

    <!-- Author Profile Box (DESIGN §5.2) -->
    {author && (
      <div class="mt-12 rounded-xl border border-border bg-surface p-6 shadow-sm">
        <div class="flex flex-col sm:flex-row gap-5 items-start">
          {authorAvatar && (
            <ResponsiveImage
              mediaId={authorAvatar.id}
              alt={author.name}
              isAvatar
              class="size-16 sm:size-18 rounded-full object-cover border border-border shrink-0"
            />
          )}
          <div class="flex-1">
            <div class="flex flex-wrap items-baseline gap-2">
              <a
                href={`/authors/${author.slug}/`}
                class="text-[1.2rem] font-bold text-text hover:text-brand"
              >
                {author.name}
              </a>
              <span class="text-caption text-muted">{author.jobTitle}</span>
            </div>
            <p class="mt-2 line-clamp-3 text-body-sm text-text-secondary">{author.bio}</p>
            {author.sameAs.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-3 text-caption">
                {author.sameAs.map((url) => {
                  const host = new URL(url).hostname.replace('www.', '');
                  return (
                    <a
                      href={url}
                      target="_blank"
                      rel="me noopener"
                      class="inline-flex min-h-[28px] items-center text-brand hover:underline underline-offset-2"
                    >
                      {host}
                    </a>
                  );
                })}
              </div>
            )}
            <div class="mt-4">
              <a
                href={`/authors/${author.slug}/`}
                class="inline-flex min-h-[36px] items-center text-caption font-semibold text-brand hover:text-brand-deep"
              >
                บทความทั้งหมดของผู้เขียน →
              </a>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Prev / Next Navigation -->
    {(prev || next) && (
      <div class="mt-12 grid grid-cols-2 gap-4 border-t border-border pt-6">
        <div>
          {prev && (
            <a
              href={`/${prev.slug}/`}
              class="group block p-3 rounded-lg border border-border/80 bg-bg hover:border-brand transition-colors"
            >
              <span class="text-[0.75rem] font-semibold text-muted uppercase">
                « บทความก่อนหน้า
              </span>
              <p class="mt-1 text-body-sm font-medium text-text group-hover:text-brand line-clamp-2">
                {prev.title}
              </p>
            </a>
          )}
        </div>
        <div class="text-right">
          {next && (
            <a
              href={`/${next.slug}/`}
              class="group block p-3 rounded-lg border border-border/80 bg-bg hover:border-brand transition-colors"
            >
              <span class="text-[0.75rem] font-semibold text-muted uppercase">บทความถัดไป »</span>
              <p class="mt-1 text-body-sm font-medium text-text group-hover:text-brand line-clamp-2">
                {next.title}
              </p>
            </a>
          )}
        </div>
      </div>
    )}
  </article>

  <!-- Related Articles Section (DESIGN §5.2) -->
  {relatedArticles.length > 0 && (
    <section aria-labelledby="related-articles" class="border-t border-border bg-surface py-12">
      <div class="mx-auto max-w-listing px-4 md:px-6">
        <h2 id="related-articles" class="text-h2 md:text-[1.75rem] font-bold text-text mb-6">
          บทความที่เกี่ยวข้อง
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedArticles.map((rel) => {
            const relMedia = rel.coverMediaId ? getMediaById(rel.coverMediaId) : undefined;
            const relCat = getCategoryById(rel.categoryId);
            const relReading = readingTimeMinutes(
              `${rel.excerpt} ${extractNodeText(rel.content as TiptapNode)}`,
            );
            return (
              <ArticleCard
                href={`/${rel.slug}/`}
                title={rel.title}
                excerpt={rel.excerpt}
                categoryLabel={relCat?.name}
                dateMs={rel.publishedAt}
                readingMinutes={relReading}
                image={
                  relMedia
                    ? {
                        mediaId: relMedia.id,
                        src: `/media/${relMedia.id}.webp`,
                        width: relMedia.width ?? 640,
                        height: relMedia.height ?? 360,
                        alt: relMedia.alt || rel.title,
                      }
                    : undefined
                }
              />
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Client-side YouTube facade click-to-load script (only included when video is present) -->
  {rendered.hasVideo && <script is:inline>
    (function () {
      if (window.__ytFacadeBound) return;
      window.__ytFacadeBound = true;
      document.addEventListener('click', function (event) {
        var button = event.target.closest('.youtube-facade > button');
        if (!button) return;
        var box = button.parentElement;
        var id = box.dataset.videoId;
        var iframe = document.createElement('iframe');
        iframe.width = '560';
        iframe.height = '315';
        iframe.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
        iframe.title = button.getAttribute('aria-label') || 'วิดีโอ YouTube';
        iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.style.aspectRatio = '16 / 9';
        iframe.style.width = '100%';
        iframe.style.height = 'auto';
        iframe.style.border = '0';
        box.replaceChildren(iframe);
      });
    })();
  </script>}
</BaseLayout>
