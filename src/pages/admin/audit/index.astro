---
// Admin audit log viewer page (DESIGN §10.5, CONTRACTS §5).
// Prerender = false; wrapped by AdminLayout. Admin only.
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AuditLogViewer from '../../../components/admin/team/AuditLogViewer.vue';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/admin/login/');
}

if (user.role !== 'admin') {
  return new Response('เฉพาะผู้ดูแลระบบเท่านั้นที่สามารถเข้าถึงหน้านี้ได้', { status: 403 });
}
---

<AdminLayout title="ประวัติการใช้งาน" active="audit">
  <div class="space-y-6">
    <div>
      <h1 class="text-h2 font-bold text-text">ประวัติการใช้งาน (Audit Logs)</h1>
      <p class="text-caption text-muted mt-1">
        บันทึกตรวจสอบความโปร่งใส ติดตามประวัติการสร้าง แก้ไข ลบ เผยแพร่บทความ และการจัดการทีมงาน
      </p>
    </div>

    <AuditLogViewer client:only="vue" />
  </div>
</AdminLayout>
