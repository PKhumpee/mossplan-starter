---
// Authors directory (DESIGN §5.6, D25, CONTRACTS §7):
// Lists every public author with a complete profile who wrote or reviewed a published article.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/public/ui/Breadcrumbs.astro';
import ResponsiveImage from '../../lib/media/ResponsiveImage.astro';
import {
  getAllAuthors,
  getAllCategories,
  getArticlesByAuthor,
  getMediaById,
  getSiteInfo,
} from '../../lib/content/queries';
import JsonLd from '../../components/seo/JsonLd.astro';
import { buildListingBreadcrumbGraph } from '../../lib/seo/schema';
import { pageTitle } from '../../lib/seo/metadata';
import { buildSite } from '../../shared/site';

const site = getSiteInfo();
const categories = getAllCategories();
const authors = getAllAuthors();

const canonical = '/authors/';
const title = pageTitle(site.name, 'ทีมผู้เขียน');
const crumbs = [{ label: 'ทีมผู้เขียน' }];
const jsonLdGraph = buildListingBreadcrumbGraph(buildSite().url, crumbs);
const description = `ทำความรู้จักกับทีมผู้เขียนและกองบรรณาธิการของ ${site.name} ผู้สร้างสรรค์บทความคุณภาพที่ตรวจสอบได้`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  siteName={site.name}
  siteDescription={site.description}
  categories={categories}
>
  <JsonLd slot="jsonld" graph={jsonLdGraph} />
  <div class="mx-auto max-w-listing px-4 py-8 md:px-6 md:py-12">
    <!-- Breadcrumbs -->
    <div class="mb-4">
      <Breadcrumbs items={crumbs} />
    </div>

    <!-- Header -->
    <header class="mb-12 border-b border-border pb-8">
      <h1 class="text-h1 md:text-[2.5rem] font-bold text-text">ทีมผู้เขียนและกองบรรณาธิการ</h1>
      <p class="mt-3 max-w-prose text-body text-text-secondary">
        บทความทุกเรื่องเขียนและตรวจทานโดยผู้เชี่ยวชาญตัวจริง มีชื่อ ตำแหน่ง
        และช่องทางยืนยันตัวตนชัดเจนตามหลัก E-E-A-T
      </p>
    </header>

    <!-- Authors Card Grid -->
    <div class="grid gap-6 md:grid-cols-2">
      {authors.map((author) => {
        const avatar = author.avatarMediaId ? getMediaById(author.avatarMediaId) : undefined;
        const articleCount = getArticlesByAuthor(author.id).length;

        return (
          <div class="flex flex-col sm:flex-row gap-5 rounded-2xl border border-border bg-bg p-6 shadow-card transition-all hover:shadow-elevated hover:border-brand-subdued">
            {avatar && (
              <ResponsiveImage
                mediaId={avatar.id}
                alt={author.name}
                isAvatar
                class="size-24 rounded-full object-cover border border-border shrink-0"
              />
            )}
            <div class="flex flex-1 flex-col justify-between">
              <div>
                <h2 class="text-h3 font-bold text-text hover:text-brand">
                  <a href={`/authors/${author.slug}/`}>{author.name}</a>
                </h2>
                <p class="text-caption font-medium text-brand mt-0.5">{author.jobTitle}</p>
                <p class="mt-2.5 line-clamp-3 text-body-sm text-text-secondary">{author.bio}</p>
              </div>
              <div class="mt-5 flex items-center justify-between border-t border-border/70 pt-3 text-caption">
                <span class="text-muted tabular-nums">เขียน {articleCount} บทความ</span>
                <a
                  href={`/authors/${author.slug}/`}
                  class="inline-flex min-h-[36px] items-center font-semibold text-brand hover:text-brand-deep"
                >
                  ดูประวัติและผลงาน →
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>
