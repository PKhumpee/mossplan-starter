---
// Contact page (DESIGN §5.5, D28, CONTRACTS §2a, §7):
// Static email address derived from buildSite() — no form, so readers never hit Worker.
// Draft Thai copy awaiting owner review before launch (T20).
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/public/ui/Breadcrumbs.astro';
import Prose from '../components/public/ui/Prose.astro';
import { getAllCategories, getSiteInfo } from '../lib/content/queries';
import { buildSite } from '../shared/site';

const site = getSiteInfo();
const categories = getAllCategories();
const siteConfig = buildSite();

export const LAST_UPDATED = '14 ต.ค. 2569';

const canonical = '/contact/';
const title = `ติดต่อเรา — ${site.name}`;
const description = `ช่องทางการติดต่อทีมงานกองบรรณาธิการของ ${site.name} สำหรับข้อเสนอแนะและแจ้งแก้ไขข้อมูล`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  siteName={site.name}
  siteDescription={site.description}
  categories={categories}
>
  <div class="mx-auto max-w-prose px-4 py-8 md:px-6 md:py-12">
    <div class="mb-4">
      <Breadcrumbs items={[{ label: 'ติดต่อเรา' }]} />
    </div>

    <header class="mb-8 border-b border-border pb-6">
      <h1 class="text-h1 md:text-[2.5rem] font-bold text-text">ติดต่อเรา</h1>
      <p class="mt-2 text-caption text-muted tabular-nums">ปรับปรุงล่าสุด {LAST_UPDATED}</p>
    </header>

    <Prose>
      <p>
        ทีมงาน <strong>{site.name}</strong> ยินดีรับฟังความคิดเห็น ข้อเสนอแนะ
        รวมถึงการแจ้งข้อผิดพลาดในบทความเพื่อนำไปพัฒนาและปรับปรุงให้ดียิ่งขึ้น
      </p>

      <h2>ช่องทางการติดต่อทางอีเมล</h2>
      <p>คุณสามารถส่งอีเมลถึงกองบรรณาธิการได้โดยตรงที่:</p>
      <div class="my-6 rounded-xl border border-border bg-surface p-6 shadow-sm">
        <p class="text-caption font-semibold text-muted uppercase">อีเมลสำหรับติดต่อทั่วไป</p>
        <p class="mt-1 text-[1.25rem] font-bold text-brand">
          <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
        </p>
        <p class="mt-2 text-body-sm text-text-secondary">
          สำหรับการแจ้งแก้ไขข้อผิดพลาดในเนื้อหา ข้อเสนอแนะ หรือการร่วมงาน
        </p>
      </div>

      <h2>เรื่องที่สามารถติดต่อได้</h2>
      <ul>
        <li>
          <strong>การแจ้งแก้ไขเนื้อหา:</strong> หากพบข้อมูลที่คลาดเคลื่อน โปรดระบุ URL
          ของบทความและข้อมูลที่ถูกต้องพร้อมแหล่งอ้างอิง
        </li>
        <li>
          <strong>ข้อเสนอแนะทั่วไป:</strong> ความคิดเห็นเกี่ยวกับเว็บไซต์และการใช้งาน
        </li>
        <li>
          <strong>คำถามเกี่ยวกับนโยบายความเป็นส่วนตัว:</strong>{' '}
          การใช้สิทธิตามกฎหมายคุ้มครองข้อมูลส่วนบุคคล (PDPA)
        </li>
      </ul>

      <h2>ระยะเวลาในการตอบกลับ</h2>
      <p>ทีมงานจะพิจารณาและตอบกลับอีเมลของคุณภายใน 1–3 วันทำการ</p>
    </Prose>
  </div>
</BaseLayout>
