---
// Styleguide (T02): Stripe design system & tokens (https://www.designmd.co/d/stripe).
// Every public component with Thai sample text, in light and dark (dashboard track).
// noindex and excluded from the sitemap (astro.config.ts). Zero client JS.
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/public/ui/ArticleCard.astro';
import Pagination from '../components/public/ui/Pagination.astro';
import Breadcrumbs from '../components/public/ui/Breadcrumbs.astro';
import TagChip from '../components/public/ui/TagChip.astro';
import Prose from '../components/public/ui/Prose.astro';
import YouTubeFacade from '../components/public/ui/YouTubeFacade.astro';

import { getAllCategories, getAllTags, getPublishedArticles } from '../lib/content/queries';
import tokens from '../../design/tokens.json';

const categories = getAllCategories();
const tags = getAllTags();
const sampleArticles = getPublishedArticles();
const sampleSlug = sampleArticles[0]?.slug ?? 'improve-home-wifi';

// Inline SVG cover using design tokens
const coverSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="640" height="360">
  <rect width="640" height="360" fill="var(--moss-primary)"/>
  <circle cx="320" cy="180" r="80" fill="none" stroke="var(--moss-surface)" stroke-width="40"/>
</svg>`;
const cover = `data:image/svg+xml,${encodeURIComponent(coverSvg)}`;

const sampleDate = Date.UTC(2026, 9, 14, 2, 0); // 14 ต.ค. 2569, Bangkok
---

<BaseLayout
  title="Styleguide — Stripe Design System"
  description="หน้าแสดงชุดดีไซน์และโทเคนตามสเปก Stripe (DesignMD) สำหรับตรวจสอบงานภายในทีม"
  canonical="/styleguide/"
  noindex
  categories={categories}
>
  <!-- Stripe atmospheric gradient mesh hero band -->
  <div class="stripe-mesh-gradient border-b border-border py-12 md:py-16">
    <div class="mx-auto max-w-listing px-4 md:px-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-brand/20 bg-brand-subdued/30 px-3.5 py-1 text-caption font-medium text-brand">
        <span>Stripe Design Language</span>
        <span class="opacity-50">/</span>
        <span>DesignMD Specification</span>
      </div>
      <h1 class="mt-4 text-[2.25rem] leading-[1.25] font-bold text-text md:text-[3rem]">
        ชุดดีไซน์และโทเคน (Styleguide)
      </h1>
      <p class="mt-3 max-w-prose text-body text-text-secondary">
        ออกแบบตามภาษางานดีไซน์ของ Stripe (DesignMD): สีหมึกน้ำเงินลึก (
        <code class="text-caption">{tokens.color.light.text}</code>), สีหลักอินดิโก (
        <code class="text-caption">{tokens.color.light.primary}</code>), พื้นผิว{' '}
        <code class="text-caption">{tokens.color.light.bg}</code>, เส้นขอบแฮร์ไลน์{' '}
        <code class="text-caption">{tokens.color.light.grid}</code> และการแสดงตัวเลขแบบ{' '}
        <span class="tabular-nums font-semibold">tabular-nums</span>
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-listing px-4 py-12 md:px-6">
    <!-- Typography -->
    <section aria-labelledby="typo" class="mt-4">
      <div class="flex items-baseline justify-between border-b border-border pb-3">
        <h2 id="typo" class="text-h2 md:text-[1.875rem] text-text">
          ระบบตัวอักษร (Typography)
        </h2>
        <span class="text-caption text-muted">Noto Sans Thai + Sohne System</span>
      </div>
      <div class="mt-6 grid gap-8 md:grid-cols-2">
        <div class="space-y-3">
          <p class="text-h1 md:text-[2.25rem] text-text font-bold">H1 พาดพิสูจน์ตัวอักษรไทย</p>
          <p class="text-h2 md:text-[1.75rem] text-text font-bold">H2 สระและวรรณยุกต์ซ้อนกัน</p>
          <p class="text-h3 md:text-[1.35rem] text-text font-semibold">H3 ผู้ใหญ่ น้ำ กิ๊ฟ</p>
          <p class="text-h4 md:text-[1.15rem] text-text font-semibold">H4 ปรับปรุงล่าสุด</p>
          <p class="text-body text-text">
            เนื้อความ 18 พิกเซลบนมือถือ และ 19 พิกเซลบนจอใหญ่ บรรทัดสูง 1.75 เพื่อเว้นที่ให้สระบน
            สระล่าง และวรรณยุกต์ที่ซ้อนกัน เช่น ผู้ใหญ่ น้ำ กิ๊ฟ อ่านได้ต่อเนื่องไม่ทับเส้น
          </p>
          <p class="text-body-sm text-muted tabular-nums">
            ข้อความกำกับ 15 พิกเซล เผยแพร่ 14 ต.ค. 2569 · อ่าน 6 นาที · รายได้ ฿1,250.00
          </p>
          <p class="text-caption text-muted">คำอธิบายภาพ 14 พิกเซล</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-6 shadow-sm">
          <p class="text-body-sm font-semibold text-text-secondary">
            การตรวจสอบสระและวรรณยุกต์ (Diacritics Verification)
          </p>
          <p class="mt-3 text-[2.75rem] leading-[1.3] font-bold text-text">ผู้ใหญ่ น้ำ กิ๊ฟ</p>
          <p class="mt-2 text-caption text-muted">
            ตรวจสอบว่าไม่มีการตัดขอบวรรณยุกต์บน (ไม้โท, ไม้ตรี) และสระล่าง (สระอุ, สระอู)
          </p>
          <div class="mt-6 pt-4 border-t border-border flex flex-wrap items-center gap-4 text-body-sm">
            <a
              href="#typo"
              class="font-medium text-brand hover:text-brand-deep underline underline-offset-4"
            >
              ลิงก์อินดิโกภายในหน้า
            </a>
            <span class="text-muted">·</span>
            <span class="text-muted">ข้อความสีหมึกรอง (ink-mute)</span>
            <span class="text-muted">·</span>
            <span class="tabular-nums font-semibold text-text">฿45,000 / เดือน</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Colors (Stripe Tokens from DesignMD) -->
    <section aria-labelledby="colours" class="mt-16">
      <div class="flex items-baseline justify-between border-b border-border pb-3">
        <h2 id="colours" class="text-h2 md:text-[1.875rem] text-text">
          โทเคนสี (Stripe Color Tokens)
        </h2>
        <span class="text-caption text-muted">DesignMD Stripe Spec</span>
      </div>
      <p class="mt-3 text-body-sm text-muted">
        สีหลักอินดิโก (<code class="text-caption">{tokens.color.light.primary}</code>)
        จับคู่กับสีหมึกน้ำเงินลึก (<code class="text-caption">{tokens.color.light.text}</code>)
        บนพื้นผ้าใบสะอาด (<code class="text-caption">{tokens.color.light.surface}</code> /{' '}
        <code class="text-caption">{tokens.color.light.bg}</code>)
      </p>

      <!-- Light Palette -->
      <h3 class="mt-6 text-body font-semibold text-text">โหมดสว่าง (Canvas / Marketing Light)</h3>
      <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-6">
        {[
          ['Primary', 'bg-brand', tokens.color.light.primary],
          ['Primary Deep', 'bg-brand-deep', tokens.color.light.primary],
          ['Primary Soft', 'bg-brand-soft', tokens.color.light.primary],
          ['Subdued Tag', 'bg-brand-subdued', tokens.color.light.grid],
          ['Ink (Text)', 'bg-text', tokens.color.light.text],
          ['Ink Secondary', 'bg-text-secondary', tokens.color.light.muted],
          ['Ink Mute', 'bg-muted', tokens.color.light.muted],
          ['Canvas (Bg)', 'bg-bg border border-border', tokens.color.light.bg],
          ['Canvas Soft', 'bg-surface border border-border', tokens.color.light.surface],
          ['Canvas Cream', 'bg-surface-cream border border-border', tokens.color.light.bg],
          ['Hairline', 'bg-border', tokens.color.light.grid],
          ['Ruby (Danger)', 'bg-danger', tokens.color.light.text],
        ].map(([label, bg, hex]) => (
          <div class="rounded-xl border border-border bg-bg p-3 shadow-sm">
            <div class={`h-8 w-full rounded-lg ${bg}`} />
            <p class="mt-2 text-caption font-semibold text-text">{label}</p>
            <p class="mt-0.5 text-[0.75rem] font-medium text-muted tabular-nums">{hex}</p>
          </div>
        ))}
      </div>

      <!-- Dark Palette (Dashboard Track) -->
      <h3 class="mt-8 text-body font-semibold text-text">โหมดมืด (Dashboard Track Shell)</h3>
      <p class="mt-1 text-caption text-muted">
        จำลองหน้าจอแอปพลิเคชันหลังบ้านในชุดสีเข้มของ Stripe (
        <code class="text-caption">{tokens.color.dark.bg}</code> /{' '}
        <code class="text-caption">{tokens.color.dark.surface}</code>)
      </p>
      <div
        data-theme="dark"
        class="theme-dark mt-3 grid grid-cols-2 gap-3 rounded-xl border border-border bg-bg p-4 sm:grid-cols-3 md:grid-cols-6 shadow-card"
      >
        {[
          ['Brand Dark', 'bg-brand', tokens.color.dark.primary],
          ['Surface Navy', 'bg-surface border border-border', tokens.color.dark.surface],
          ['Text Light', 'bg-text', tokens.color.dark.text],
          ['Text Muted', 'bg-muted', tokens.color.dark.muted],
          ['Border Navy', 'bg-border', tokens.color.dark.grid],
          ['Ruby Dark', 'bg-danger', tokens.color.dark.text],
        ].map(([label, bg, hex]) => (
          <div class="rounded-xl border border-border bg-surface p-3 shadow-sm">
            <div class={`h-8 w-full rounded-lg ${bg}`} />
            <p class="mt-2 text-caption font-semibold text-text">{label}</p>
            <p class="mt-0.5 text-[0.75rem] font-medium text-muted tabular-nums">{hex}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Article cards (Stripe Card Aesthetic) -->
    <section aria-labelledby="cards" class="mt-16">
      <div class="flex items-baseline justify-between border-b border-border pb-3">
        <h2 id="cards" class="text-h2 md:text-[1.875rem] text-text">
          การ์ดบทความและเนื้อหา (Cards & Elevation)
        </h2>
        <span class="text-caption text-muted">12px radius · Soft Navy Shadow</span>
      </div>
      <p class="mt-3 text-body-sm text-muted">
        การ์ดสีขาวสะอาดบนพื้นผิวนุ่ม (<code class="text-caption">{tokens.color.light.bg}</code>)
        ล้อมรอบด้วยเส้นขอบแฮร์ไลน์ 1px และเงาสีน้ำเงินหลายชั้น
      </p>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        <ArticleCard
          href={`/${sampleSlug}/`}
          title="วิธีตั้งค่าความปลอดภัยของบัญชีให้ปลอดภัยจากการแอบอ้าง"
          excerpt="สรุปขั้นตอนที่ทำได้จริงใน 10 นาที ทั้งการเปิดยืนยันตัวตนสองชั้นและการตรวจเช็กอุปกรณ์ที่ล็อกอินล่าสุด"
          categoryLabel="เทคโนโลยี"
          dateMs={sampleDate}
          readingMinutes={6}
          image={{ src: cover, width: 640, height: 360, alt: 'ภาพประกอบตัวอย่างของการ์ดบทความ' }}
        />
        <ArticleCard
          href={`/${sampleSlug}/`}
          title="ออมเงินเดือนละ 3,000 บาท เริ่มต้นอย่างไรให้เห็นผล"
          excerpt="แผนออมแบบเข้าใจง่ายสำหรับคนที่เพิ่งเริ่มทำงาน พร้อมตัวอย่างการกระจายเงินตามเป้าหมาย"
          categoryLabel="การเงิน"
          dateMs={sampleDate}
          readingMinutes={4}
        />
        <ArticleCard
          href={`/${sampleSlug}/`}
          title="รีวิวหูฟังราคาไม่เกิน 2,000 บาท ที่คุ้มค่าที่สุดปี 2569"
          excerpt="เปรียบเทียบเสียง ความสบาย และแบตเตอรี่ จากการใช้งานจริงหนึ่งเดือน"
          categoryLabel="รีวิว"
          dateMs={sampleDate}
          readingMinutes={8}
          image={{ src: cover, width: 640, height: 360, alt: 'ภาพประกอบตัวอย่างของการ์ดบทความ' }}
        />
      </div>

      <!-- Cream-band feature card (Stripe chromatic interlude) -->
      <div class="mt-8 rounded-xl border border-border bg-surface-cream/50 p-6 md:p-8 shadow-card">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div>
            <span class="inline-flex rounded-full border border-warning/40 bg-warning/15 px-3 py-0.5 text-caption font-bold text-text">
              Stripe Cream-Band Accent
            </span>
            <h3 class="mt-2 text-h3 text-text font-bold">
              บัตรแนะนำพิเศษ: แถบสีครีม (Canvas Cream Interlude)
            </h3>
            <p class="mt-1 text-body-sm text-text-secondary max-w-prose">
              ใช้คั่นระหว่างหมวดหมู่เนื้อหา
              เพื่อสร้างจังหวะสายตาที่อบอุ่นโดยไม่หลุดจากตรรกะสีของแบรนด์
            </p>
          </div>
          <a
            href={`/${sampleSlug}/`}
            class="inline-flex min-h-[44px] items-center justify-center rounded-full bg-brand px-6 py-2 text-body-sm font-semibold text-brand-contrast shadow-sm transition-all hover:bg-brand-deep hover:shadow-card focus-visible:outline-none"
          >
            ดูบทความแนะนำ »
          </a>
        </div>
      </div>

      <!-- Dark mode card strip -->
      <div class="theme-dark mt-8 rounded-xl bg-bg p-6 border border-border shadow-card">
        <p class="text-caption font-semibold text-muted mb-4 uppercase tracking-wider">
          โหมดมืด (Dashboard Track)
        </p>
        <div class="grid gap-6 md:grid-cols-3">
          <ArticleCard
            href={`/${sampleSlug}/`}
            title="การ์ดโหมดมืด: วิธีเลือกแผนเน็ตมือถือให้คุ้มค่าที่สุด"
            excerpt="เช็กลิสต์ก่อนต่ออายุสัญญา และช่องทางที่ได้ส่วนลดจริง"
            categoryLabel="เทคโนโลยี"
            dateMs={sampleDate}
            readingMinutes={5}
            image={{ src: cover, width: 640, height: 360, alt: 'ภาพประกอบตัวอย่างของการ์ดบทความ' }}
          />
        </div>
      </div>
    </section>

    <!-- Breadcrumbs, tags, pagination (Stripe Pills) -->
    <section aria-labelledby="navi" class="mt-16">
      <div class="flex items-baseline justify-between border-b border-border pb-3">
        <h2 id="navi" class="text-h2 md:text-[1.875rem] text-text">
          ปุ่มทรงเม็ดยา แท็ก และการนำทาง (Pills & Navigation)
        </h2>
        <span class="text-caption text-muted">Tight Pill Radius</span>
      </div>
      <div class="mt-6 space-y-6">
        <div>
          <p class="text-caption text-muted mb-2">เส้นทางนำทาง (Breadcrumbs)</p>
          <Breadcrumbs
            items={[
              { label: 'เทคโนโลยี', href: '/category/technology/' },
              { label: 'บทความตัวอย่าง' },
            ]}
          />
        </div>
        <div>
          <p class="text-caption text-muted mb-2">แท็กป้ายกำกับนุ่มนวล (Soft Tag Chips)</p>
          <div class="flex flex-wrap gap-2">
            {tags.slice(0, 4).map((t) => (
              <TagChip tag={{ slug: t.slug, name: t.name }} />
            ))}
          </div>
        </div>
        <div>
          <p class="text-caption text-muted mb-2">ปุ่มเปลี่ยนหน้าแบบเม็ดยา (Pill Pagination)</p>
          <div class="pt-2">
            <Pagination page={2} totalPages={3} hrefFor={(p) => (p === 1 ? '/' : `/page/${p}/`)} />
          </div>
        </div>
      </div>
    </section>

    <!-- Prose (Editorial Typography) -->
    <section aria-labelledby="prose" class="mt-16">
      <div class="flex items-baseline justify-between border-b border-border pb-3">
        <h2 id="prose" class="text-h2 md:text-[1.875rem] text-text">
          เนื้อหาบทความ (Editorial Prose)
        </h2>
        <span class="text-caption text-muted">Deep Navy Ink · Indigo Accents</span>
      </div>
      <div class="mt-6 max-w-prose">
        <Prose>
          <p>
            ย่อหน้าเปิดเรื่องอธิบายคำตอบสั้น ๆ ก่อน แล้วจึงลงรายละเอียด
            ตัวอักษรไทยต้องไม่ถูกตัดกลางคำ และบรรทัดต้องสูงพอให้สระกับวรรณยุกต์ไม่ชนกัน เช่น ผู้ใหญ่
            น้ำ กิ๊ฟ
          </p>
          <h2>หัวข้อระดับสอง (H2 Title)</h2>
          <p>
            อ่านเพิ่มเติมได้ที่
            <a href="https://www.cloudflare.com/">เว็บไซต์ Cloudflare</a>{' '}
            ซึ่งเป็นลิงก์ภายนอกที่ใช้สีอินดิโกพร้อมขีดเส้นใต้
          </p>
          <ul>
            <li>รายการแบบจุดที่หนึ่ง พร้อมการจัดระยะสบายตา</li>
            <li>รายการแบบจุดที่สอง รองรับเนื้อหาขนาดยาว</li>
          </ul>
          <ol>
            <li>ขั้นตอนแรก เปิดการตั้งค่าในแดชบอร์ด</li>
            <li>ขั้นตอนที่สอง บันทึกและตรวจสอบผลลัพธ์</li>
          </ol>
          <blockquote>
            คำพูดที่ยกมาใช้เส้นด้านซ้ายสีอินดิโก ไม่ใช้ตัวเอน
            เพราะตัวเอนภาษาไทยอ่านยากและลดทอนความชัดเจน
          </blockquote>
          <h3>หัวข้อระดับสาม (H3 Subtitle)</h3>
          <pre
            tabindex="0"
            aria-label="ตัวอย่างโค้ดคำสั่ง"
          ><code>npx wrangler secret put BETTER_AUTH_SECRET</code></pre>
          <p>
            โค้ดแบบทั่วไป เช่น <code>pnpm build</code> ใช้ฟอนต์โมโนสำหรับภาษาละติน
          </p>
          <figure>
            <img
              src={cover}
              alt="ภาพตัวอย่างภายในบทความ วงกลมสีขาวบนพื้นสีน้ำเงิน"
              width="640"
              height="360"
              loading="lazy"
            />
            <figcaption>
              คำอธิบายภาพ อยู่ตรงกลางใต้ภาพ ด้วยตัวอักษรขนาด 14 พิกเซลสี ink-mute
            </figcaption>
          </figure>
          <hr />
          <h4>หัวข้อระดับสี่ (H4 Section)</h4>
          <p>จบเนื้อหาด้วยย่อหน้าสรุปข้อมูลที่กระชับและตรวจสอบได้</p>
        </Prose>
      </div>
    </section>

    <!-- YouTube facade (Stripe video box) -->
    <section aria-labelledby="yt" class="mt-16">
      <div class="flex items-baseline justify-between border-b border-border pb-3">
        <h2 id="yt" class="text-h2 md:text-[1.875rem] text-text">
          กล่องวิดีโอ (YouTube Facade)
        </h2>
        <span class="text-caption text-muted">Zero JS on Static</span>
      </div>
      <p class="mt-3 text-body-sm text-muted">
        บนหน้าบทความจริง กดปุ่มแล้วจะเปลี่ยนเป็น iframe จาก youtube-nocookie.com ทันที
      </p>
      <div class="mt-6 max-w-prose">
        <YouTubeFacade videoId="dQw4w9WgXcQ" title="วิดีโอตัวอย่างสำหรับหน้าสาธิต" />
      </div>
    </section>
  </div>
</BaseLayout>
